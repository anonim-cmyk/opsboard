{
  "name": "opsboard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "worker"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" --names \"api, web\" -c \"cyan.bold,magenta.bold\" \"npm run dev -w api\" \"npm run dev -w web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "concurrently": "^9.2.4"
  }
}
